# Public Supabase settings. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix this with NEXT_PUBLIC and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time secret used by /setup to create the first owner. Use a long random string.
BOOTSTRAP_SECRET=replace-with-a-long-random-secret

# Used in password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Set to 1 only when you intentionally run `npm run seed:demo`.
ALLOW_DEMO_SEED=0

# Server-only. Used by Look up contents on the medicine form. Create it in Google AI Studio.
GEMINI_API_KEY=
